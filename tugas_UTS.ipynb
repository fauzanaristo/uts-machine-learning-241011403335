        "# 1. Tambahkan kolom 1 untuk menghitung intercept (b)\n",
        "X_train_bias = np.c_[np.ones((X_train.shape[0], 1)), X_train]\n",
        "\n",
        "# 2. Hitung parameter menggunakan Normal Equation\n",
        "theta = np.linalg.pinv(X_train_bias.T @ X_train_bias) @ X_train_bias.T @ y_train\n",
        "\n",
        "# 3. Ambil nilai intercept dan koefisien\n",
        "b = theta[0]\n",
        "m = theta[1]\n",
