        "# Jawaban Bonus\n",
        "\n",
        "# BONUS: Perbandingan model manual dan scikit-learn\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.linear_model import LinearRegression, LogisticRegression\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score,\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 1. LINEAR REGRESSION\n",
        "# ==========================================\n",
        "\n",
        "# Model scikit-learn menggunakan data training yang sama\n",
        "model_linear_sklearn = LinearRegression()\n",
        "model_linear_sklearn.fit(X_train, y_train)\n",
        "\n",
        "pred_linear_train = model_linear_sklearn.predict(X_train)\n",
        "pred_linear_test = model_linear_sklearn.predict(X_test)\n",
        "\n",
        "# Perbandingan koefisien\n",
        "print(\"=== LINEAR REGRESSION ===\")\n",
        "print(\"Koefisien manual:\", theta[1])\n",
        "print(\"Intercept manual:\", theta[0])\n",
        "print(\"Koefisien sklearn:\", model_linear_sklearn.coef_[0])\n",
        "print(\"Intercept sklearn:\", model_linear_sklearn.intercept_)\n",
        "\n",
        "# Evaluasi data testing\n",
        "print(\"\\nEvaluasi Linear Regression pada data testing:\")\n",
        "print(\"MAE :\", mean_absolute_error(y_test, pred_linear_test))\n",
        "print(\"MSE :\", mean_squared_error(y_test, pred_linear_test))\n",
        "print(\"RMSE:\", np.sqrt(mean_squared_error(y_test, pred_linear_test)))\n",
        "print(\"R2  :\", r2_score(y_test, pred_linear_test))\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. LOGISTIC REGRESSION\n",
        "# ==========================================\n",
        "\n",
        "# Menggunakan data training yang sama dan fitur yang sudah dinormalisasi.\n",
        "# C=1.0 dan penalty='l2' adalah pengaturan default umum sklearn.\n",
        "model_logistic_sklearn = LogisticRegression(\n",
        "    C=1.0,\n",
        "    penalty=\"l2\",\n",
        "    max_iter=1000\n",
        ")\n",
        "\n",
        "model_logistic_sklearn.fit(X_train_scaled, y_train_email)\n",
        "\n",
        "prob_sklearn = model_logistic_sklearn.predict_proba(\n",
        "    X_test_scaled\n",
        ")[:, 1]\n",
        "\n",
        "pred_sklearn = (prob_sklearn >= 0.5).astype(int)\n",
        "\n",
        "# Prediksi model manual B2\n",
        "prob_manual = sigmoid(\n",
        "    np.c_[\n",
        "        np.ones(len(X_test_scaled)),\n",
        "        X_test_scaled\n",
        "    ] @ theta_email\n",
        ").ravel()\n",
        "\n",
        "pred_manual = (prob_manual >= 0.5).astype(int)\n",
        "\n",
        "print(\"\\n=== LOGISTIC REGRESSION ===\")\n",
        "print(\"Intercept manual:\", theta_email[0, 0])\n",
        "print(\"Koefisien manual:\", theta_email[1:, 0])\n",
        "print(\"Intercept sklearn:\", model_logistic_sklearn.intercept_[0])\n",
        "print(\"Koefisien sklearn:\", model_logistic_sklearn.coef_[0])\n",
        "\n",
        "# Evaluasi kedua model pada data testing\n",
        "def tampilkan_evaluasi(nama, y_true, y_pred):\n",
        "    print(f\"\\n{nama}\")\n",
        "    print(\"Confusion Matrix:\\n\", confusion_matrix(y_true, y_pred))\n",
        "    print(\"Accuracy :\", accuracy_score(y_true, y_pred))\n",
        "    print(\"Precision:\", precision_score(y_true, y_pred, zero_division=0))\n",
