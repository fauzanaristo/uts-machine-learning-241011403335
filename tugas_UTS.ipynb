      "source": [
        "# Jawaban A4\n",
        "\n",
        "# Jawaban A4\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Fungsi evaluasi dibuat sendiri menggunakan NumPy\n",
        "def hitung_mae(y_asli, y_prediksi):\n",
        "    return np.mean(np.abs(y_asli - y_prediksi))\n",
        "\n",
        "def hitung_mse(y_asli, y_prediksi):\n",
        "    return np.mean((y_asli - y_prediksi) ** 2)\n",
        "\n",
        "def hitung_rmse(y_asli, y_prediksi):\n",
        "    return np.sqrt(hitung_mse(y_asli, y_prediksi))\n",
        "\n",
        "def hitung_r2(y_asli, y_prediksi):\n",
        "    ss_res = np.sum((y_asli - y_prediksi) ** 2)\n",
        "    ss_tot = np.sum((y_asli - np.mean(y_asli)) ** 2)\n",
        "    if ss_tot == 0:\n",
        "        return np.nan\n",
        "    return 1 - (ss_res / ss_tot)\n",
        "\n",
        "# Prediksi untuk data training dan testing\n",
        "X_train_bias = np.c_[np.ones((X_train.shape[0], 1)), X_train]\n",
        "X_test_bias = np.c_[np.ones((X_test.shape[0], 1)), X_test]\n",
        "\n",
        "y_pred_train = X_train_bias @ theta\n",
        "y_pred_test = X_test_bias @ theta\n",
        "\n",
        "# Hitung metrik untuk kedua data\n",
        "hasil = pd.DataFrame({\n",
        "    \"Metrik\": [\"MAE\", \"MSE\", \"RMSE\", \"R2\"],\n",
        "    \"Training\": [\n",
        "        hitung_mae(y_train, y_pred_train),\n",
        "        hitung_mse(y_train, y_pred_train),\n",
        "        hitung_rmse(y_train, y_pred_train),\n",
        "        hitung_r2(y_train, y_pred_train)\n",
        "    ],\n",
        "    \"Testing\": [\n",
        "        hitung_mae(y_test, y_pred_test),\n",
        "        hitung_mse(y_test, y_pred_test),\n",
        "        hitung_rmse(y_test, y_pred_test),\n",
        "        hitung_r2(y_test, y_pred_test)\n",
        "    ]\n",
        "})\n",
        "\n",
        "print(\"Hasil Evaluasi Model Linear Regression:\")\n",
        "print(hasil.round(4).to_string(index=False))\n"
      ],
      "id": "cell-14"
