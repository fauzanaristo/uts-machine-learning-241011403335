        "# Jawaban A5\n",
        "\n",
        "# Jawaban A5 - Gradient Descent & Learning Rate\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Gunakan data training dari Soal A2\n",
        "X_gd = np.c_[np.ones((X_train.shape[0], 1)), X_train]\n",
        "y_gd = y_train.reshape(-1, 1)\n",
        "\n",
        "n_iterations = 5000\n",
        "learning_rates = [0.001, 0.02, 0.1]\n",
        "\n",
        "hasil_gd = []\n",
        "riwayat_loss = {}\n",
        "\n",
        "# Nilai normal equation dari Soal A3 sebagai pembanding\n",
        "theta_normal = theta.reshape(-1, 1)\n",
        "\n",
        "for lr in learning_rates:\n",
        "    # Mulai dari parameter nol untuk setiap eksperimen\n",
        "    theta_gd = np.zeros((X_gd.shape[1], 1))\n",
        "    losses = []\n",
        "\n",
        "    for iteration in range(n_iterations):\n",
        "        # Prediksi dan hitung MSE\n",
        "        y_pred = X_gd @ theta_gd\n",
        "        error = y_pred - y_gd\n",
        "        loss = np.mean(error ** 2)\n",
        "        losses.append(loss)\n",
        "\n",
        "        # Jika nilai sudah tidak stabil, hentikan eksperimen\n",
        "        if not np.isfinite(loss) or not np.all(np.isfinite(theta_gd)):\n",
        "            break\n",
        "\n",
        "        # Gradient Descent\n",
        "        gradient = (2 / len(y_gd)) * (X_gd.T @ error)\n",
        "        theta_gd = theta_gd - lr * gradient\n",
        "\n",
        "    riwayat_loss[lr] = losses\n",
        "\n",
        "    # Simpan hasil akhir\n",
        "    if np.all(np.isfinite(theta_gd)):\n",
        "        b_gd = theta_gd[0, 0]\n",
        "        m_gd = theta_gd[1, 0]\n",
        "    else:\n",
        "        b_gd = np.nan\n",
        "        m_gd = np.nan\n",
        "\n",
        "    hasil_gd.append({\n",
        "        \"Learning Rate\": lr,\n",
        "        \"Intercept GD\": b_gd,\n",
        "        \"Koefisien GD\": m_gd,\n",
        "        \"Intercept Normal Equation\": theta_normal[0, 0],\n",
        "        \"Koefisien Normal Equation\": theta_normal[1, 0],\n",
        "        \"Iterasi Tercatat\": len(losses),\n",
        "        \"Loss Terakhir\": losses[-1]\n",
        "    })\n",
        "\n",
        "# Tampilkan perbandingan parameter\n",
        "tabel_gd = pd.DataFrame(hasil_gd)\n",
        "print(\"Perbandingan Gradient Descent dengan Normal Equation:\")\n",
        "print(tabel_gd.round(6).to_string(index=False))\n",
        "\n",
        "# Grafik loss MSE terhadap iterasi\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "for lr, losses in riwayat_loss.items():\n",
        "    losses = np.array(losses, dtype=float)\n",
        "    valid = np.isfinite(losses) & (losses > 0)\n",
        "    if np.any(valid):\n",
        "        plt.plot(\n",
        "            np.arange(len(losses))[valid],\n",
        "            losses[valid],\n",
        "            label=f\"Learning rate = {lr}\"\n",
        "        )\n",
        "\n",
        "plt.yscale(\"log\")\n",
        "plt.xlabel(\"Iterasi\")\n",
        "plt.ylabel(\"Loss (MSE), skala log\")\n",
        "plt.title(\"Gradient Descent: Loss vs Iterasi\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n"
