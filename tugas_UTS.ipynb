      "source": [
        "# Jawaban B2\n",
        "\n",
        "# Jawaban B2 - Split Data & Training Logistic Regression\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "RANDOM_STATE = 35\n",
        "\n",
        "# 1. Split data: 75% training dan 25% testing\n",
        "X_train_email, X_test_email, y_train_email, y_test_email = train_test_split(\n",
        "    X_email, y_email, test_size=0.25, random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "print(\"Shape X_train:\", X_train_email.shape)\n",
        "print(\"Shape X_test :\", X_test_email.shape)\n",
        "print(\"Shape y_train:\", y_train_email.shape)\n",
        "print(\"Shape y_test :\", y_test_email.shape)\n",
        "\n",
        "# Normalisasi fitur agar Gradient Descent lebih stabil\n",
        "mean_email = X_train_email.mean(axis=0)\n",
        "std_email = X_train_email.std(axis=0)\n",
        "std_email[std_email == 0] = 1\n",
        "\n",
        "X_train_scaled = (X_train_email - mean_email) / std_email\n",
        "X_test_scaled = (X_test_email - mean_email) / std_email\n",
        "\n",
        "# Tambahkan kolom bias/intercept\n",
        "X_train_bias_email = np.c_[\n",
        "    np.ones(len(X_train_scaled)), X_train_scaled\n",
        "]\n",
        "\n",
        "# 2. Logistic Regression dengan Gradient Descent\n",
        "def sigmoid(z):\n",
        "    z = np.clip(z, -500, 500)\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "learning_rate = 0.1\n",
        "n_iterations = 10000\n",
        "n = len(y_train_email)\n",
        "\n",
        "y_train_col = y_train_email.reshape(-1, 1).astype(float)\n",
        "theta_email = np.zeros((X_train_bias_email.shape[1], 1))\n",
        "log_loss_history = []\n",
        "\n",
        "for i in range(n_iterations):\n",
        "    z = X_train_bias_email @ theta_email\n",
        "    prob = sigmoid(z)\n",
        "\n",
        "    # Log loss\n",
        "    eps = 1e-15\n",
        "    prob_safe = np.clip(prob, eps, 1 - eps)\n",
        "    loss = -np.mean(\n",
        "        y_train_col * np.log(prob_safe)\n",
        "        + (1 - y_train_col) * np.log(1 - prob_safe)\n",
        "    )\n",
        "    log_loss_history.append(loss)\n",
        "\n",
        "    # Gradient Descent\n",
        "    gradient = (\n",
        "        X_train_bias_email.T @ (prob - y_train_col)\n",
        "    ) / n\n",
        "    theta_email -= learning_rate * gradient\n",
        "\n",
        "# 3. Tampilkan parameter dalam skala fitur asli\n",
        "# Model dilatih pada fitur standar, jadi koefisien dikembalikan\n",
        "# ke skala JumlahLink dan KataPromo agar persamaan mudah dibaca.\n",
        "b_scaled = theta_email[0, 0]\n",
        "m_scaled = theta_email[1:, 0]\n",
        "\n",
        "m_asli = m_scaled / std_email\n",
        "b_asli = b_scaled - np.sum(m_scaled * mean_email / std_email)\n",
        "\n",
        "print(\"\\nIntercept (b):\", b_asli)\n",
        "print(\"Koefisien m1 (JumlahLink):\", m_asli[0])\n",
        "print(\"Koefisien m2 (KataPromo):\", m_asli[1])\n",
        "\n",
        "print(\n",
        "    \"\\nPersamaan model:\"\n",
        "    f\"\\nP(Spam) = sigmoid({b_asli:.4f}\"\n",
        "    f\" + ({m_asli[0]:.4f} * JumlahLink)\"\n",
        "    f\" + ({m_asli[1]:.4f} * KataPromo))\"\n",
        ")\n",
        "\n",
        "# 4. Grafik log loss vs iterasi\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(log_loss_history)\n",
        "plt.title(\"Log Loss vs Iterasi - Logistic Regression\")\n",
        "plt.xlabel(\"Iterasi\")\n",
        "plt.ylabel(\"Log Loss\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nLog loss awal:\", round(log_loss_history[0], 6))\n",
        "print(\"Log loss akhir:\", round(log_loss_history[-1], 6))\n"
