        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Memuat dataset\n",
        "df_email = pd.read_csv(\"Email_Data.csv\")\n",
        "\n",
        "X_email = df_email[[\"JumlahLink\", \"KataPromo\"]].values.astype(float)\n",
        "y_email = df_email[\"Spam\"].values.astype(int)\n",
        "\n",
        "print(\"Jumlah data:\", len(X_email))\n",
        "\n",
        "# 2. Membagi data: 75% training, 25% testing\n",
        "RANDOM_STATE = 35\n",
        "\n",
        "np.random.seed(RANDOM_STATE)\n",
        "indices = np.random.permutation(len(X_email))\n",
        "\n",
        "n_test = int(np.ceil(len(X_email) * 0.25))\n",
        "test_indices = indices[:n_test]\n",
        "train_indices = indices[n_test:]\n",
        "\n",
        "X_train_email = X_email[train_indices]\n",
        "X_test_email = X_email[test_indices]\n",
        "y_train_email = y_email[train_indices]\n",
        "y_test_email = y_email[test_indices]\n",
        "\n",
        "print(\"X_train:\", X_train_email.shape)\n",
        "print(\"X_test :\", X_test_email.shape)\n",
        "print(\"y_train:\", y_train_email.shape)\n",
        "print(\"y_test :\", y_test_email.shape)\n",
        "\n",
        "# 3. Normalisasi data\n",
        "mean_email = X_train_email.mean(axis=0)\n",
        "std_email = X_train_email.std(axis=0)\n",
        "std_email[std_email == 0] = 1\n",
        "\n",
        "X_train_scaled = (X_train_email - mean_email) / std_email\n",
        "X_test_scaled = (X_test_email - mean_email) / std_email\n",
        "\n",
        "# 4. Menambahkan kolom bias\n",
        "X_train_bias_email = np.c_[\n",
        "    np.ones(len(X_train_scaled)),\n",
        "    X_train_scaled\n",
        "]\n",
        "\n",
        "# 5. Fungsi sigmoid\n",
        "def sigmoid(z):\n",
        "    z = np.clip(z, -500, 500)\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "# 6. Melatih Logistic Regression dengan Gradient Descent\n",
        "theta_email = np.zeros((X_train_bias_email.shape[1], 1))\n",
        "\n",
        "y_train_col = y_train_email.reshape(-1, 1).astype(float)\n",
        "\n",
        "learning_rate = 0.1\n",
        "n_iterations = 10000\n",
        "n = len(y_train_email)\n",
        "log_loss_history = []\n",
        "\n",
        "for i in range(n_iterations):\n",
        "    z = X_train_bias_email @ theta_email\n",
        "    prob = sigmoid(z)\n",
        "\n",
        "    prob_safe = np.clip(prob, 1e-15, 1 - 1e-15)\n",
        "\n",
        "    loss = -np.mean(\n",
        "        y_train_col * np.log(prob_safe)\n",
        "        + (1 - y_train_col) * np.log(1 - prob_safe)\n",
        "    )\n",
        "\n",
        "    log_loss_history.append(loss)\n",
        "\n",
        "    gradient = (\n",
        "        X_train_bias_email.T @ (prob - y_train_col)\n",
        "    ) / n\n",
        "\n",
        "    theta_email -= learning_rate * gradient\n",
        "\n",
        "# 7. Menampilkan persamaan model\n",
        "b_scaled = theta_email[0, 0]\n",
        "m_scaled = theta_email[1:, 0]\n",
        "\n",
        "m_asli = m_scaled / std_email\n",
        "b_asli = b_scaled - np.sum(m_scaled * mean_email / std_email)\n",
        "\n",
        "print(\"\\nIntercept:\", b_asli)\n",
        "print(\"Koefisien JumlahLink:\", m_asli[0])\n",
        "print(\"Koefisien KataPromo:\", m_asli[1])\n",
        "\n",
        "print(\n",
        "    f\"P(Spam) = sigmoid({b_asli:.4f} \"\n",
        "    f\"+ ({m_asli[0]:.4f} * JumlahLink) \"\n",
        "    f\"+ ({m_asli[1]:.4f} * KataPromo))\"\n",
        ")\n",
        "\n",
        "# 8. Grafik perubahan Log Loss\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(log_loss_history)\n",
        "plt.title(\"Perubahan Log Loss Logistic Regression\")\n",
        "plt.xlabel(\"Iterasi\")\n",
        "plt.ylabel(\"Log Loss\")\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ],
