      "source": [
        "# Jawaban B5\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Menghitung probabilitas spam pada data testing\n",
        "# Ini berfungsi seperti predict_proba untuk kelas Spam (1).\n",
        "X_test_bias_email = np.c_[\n",
        "    np.ones(len(X_test_scaled)),\n",
        "    X_test_scaled\n",
        "]\n",
        "\n",
        "predict_proba = sigmoid(\n",
        "    X_test_bias_email @ theta_email\n",
        ").ravel()\n",
        "\n",
        "# 2. Fungsi evaluasi manual\n",
        "def confusion_matrix_manual(y_true, y_pred):\n",
        "    tn = np.sum((y_true == 0) & (y_pred == 0))\n",
        "    fp = np.sum((y_true == 0) & (y_pred == 1))\n",
        "    fn = np.sum((y_true == 1) & (y_pred == 0))\n",
        "    tp = np.sum((y_true == 1) & (y_pred == 1))\n",
        "\n",
        "    return np.array([[tn, fp], [fn, tp]])\n",
        "\n",
        "def precision_manual(y_true, y_pred):\n",
        "    cm = confusion_matrix_manual(y_true, y_pred)\n",
        "    tp = cm[1, 1]\n",
        "    fp = cm[0, 1]\n",
        "    return tp / (tp + fp) if (tp + fp) > 0 else 0.0\n",
        "\n",
        "def recall_manual(y_true, y_pred):\n",
        "    cm = confusion_matrix_manual(y_true, y_pred)\n",
        "    tp = cm[1, 1]\n",
        "    fn = cm[1, 0]\n",
        "    return tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
        "\n",
        "# 3. Menguji tiga threshold\n",
        "thresholds = [0.3, 0.5, 0.7]\n",
        "hasil_threshold = []\n",
        "\n",
        "for threshold in thresholds:\n",
        "    # Prediksi spam jika probabilitas >= threshold\n",
        "    y_pred_threshold = (\n",
        "        predict_proba >= threshold\n",
        "    ).astype(int)\n",
        "\n",
        "    cm = confusion_matrix_manual(\n",
        "        y_test_email, y_pred_threshold\n",
        "    )\n",
        "\n",
        "    precision = precision_manual(\n",
        "        y_test_email, y_pred_threshold\n",
        "    )\n",
        "\n",
        "    recall = recall_manual(\n",
        "        y_test_email, y_pred_threshold\n",
        "    )\n",
        "\n",
        "    hasil_threshold.append({\n",
        "        \"Threshold\": threshold,\n",
        "        \"TN\": cm[0, 0],\n",
        "        \"FP\": cm[0, 1],\n",
        "        \"FN\": cm[1, 0],\n",
        "        \"TP\": cm[1, 1],\n",
        "        \"Precision\": precision,\n",
        "        \"Recall\": recall\n",
        "    })\n",
        "\n",
        "# 4. Menampilkan hasil dalam satu tabel\n",
        "tabel_threshold = pd.DataFrame(hasil_threshold)\n",
        "\n",
        "print(\"Perbandingan Hasil Threshold:\")\n",
        "print(tabel_threshold.round(4).to_string(index=False))\n"
      ],
